# Copy to .env.local (gitignored). None of these are secrets; they end up in the browser bundle.

# "dev": header-based sign-in with a role picker, for local use without a tenant. Never deploy this.
# "entra": Microsoft Entra ID via MSAL (see docs/auth/entra-setup.md).
VITE_AUTH_MODE=dev

# Only for VITE_AUTH_MODE=entra
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
# api://<api-app-id>/access_as_user
VITE_API_SCOPE=

# Where the Vite dev server forwards /api (default http://localhost:5080)
# API_PROXY_TARGET=http://localhost:5080

# Production builds only: the API origin. Also written into staticwebapp.config.json (CSP).
# VITE_API_BASE_URL=https://<api-app>.azurewebsites.net
