<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Hosts the real API in memory (WebApplicationFactory). Tests tagged Category=Database run against
    SQL Server in a container (Testcontainers) and need Docker. The others need no database.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.MsSql" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RaceShop.Api\RaceShop.Api.csproj" />
  </ItemGroup>
</Project>
