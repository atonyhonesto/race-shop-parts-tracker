<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Composition root and HTTP surface (minimal APIs). The only project that knows every layer (ADR 0001). -->
  <PropertyGroup>
    <!-- Local connection string lives in user secrets, never in appsettings (see CONTRIBUTING.md). -->
    <UserSecretsId>raceshop-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Identity.Web" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests use the auth constants (header names, policy names) instead of repeating string literals. -->
    <InternalsVisibleTo Include="RaceShop.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RaceShop.Application\RaceShop.Application.csproj" />
    <ProjectReference Include="..\RaceShop.Infrastructure\RaceShop.Infrastructure.csproj" />
  </ItemGroup>
</Project>
