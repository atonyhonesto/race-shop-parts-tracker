# Normalize line endings: LF in the repo and in working trees, on every OS.
# Windows-only scripts keep CRLF so cmd.exe parses them correctly.
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pfx binary
