{
  "name": "@raceshop/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript client generated from the API's OpenAPI contract (openapi.json).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "typescript": "~6.0.3"
  },
  "files": [
    "dist"
  ]
}
