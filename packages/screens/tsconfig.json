{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // CSS Modules are typed as an index signature by Vite; `styles.button` is the idiomatic access.
    // noUncheckedIndexedAccess still types each class as string | undefined.
    "noPropertyAccessFromIndexSignature": false,
    "noEmit": true
  },
  "include": ["src", "vitest.config.ts"]
}
